<Window x:Class="Pace.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pace" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowActivated="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Primary}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Primary}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact checkbox toggle. -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="14" Height="14" CornerRadius="3.5" BorderThickness="1"
                      BorderBrush="{DynamicResource Border}" Background="{DynamicResource Field}">
                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource Separator}" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Slim linear progress bar, tinted by usage thresholds. -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="5" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2.5" Background="{DynamicResource Track}" />
              <Border x:Name="PART_Indicator" CornerRadius="2.5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Card" Margin="12" CornerRadius="9" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1" RenderTransformOrigin="0.5,1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black" />
    </Border.Effect>
    <Border.RenderTransform>
      <TranslateTransform x:Name="Slide" />
    </Border.RenderTransform>

    <StackPanel Width="252" Margin="14">
      <!-- Header: title + plan capsule -->
      <Grid>
        <TextBlock Text="Claude Usage" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border HorizontalAlignment="Right" CornerRadius="8" Padding="6,1.5" Background="{DynamicResource AccentSoft}"
                Visibility="{Binding HasPlan, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding PlanText}" FontSize="10" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Margin="0,12,0,0"
                 Visibility="{Binding HasError, Converter={StaticResource Vis}}" />

      <ItemsControl ItemsSource="{Binding Limits}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,12,0,0">
              <Grid>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" />
                <TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Typography.NumeralAlignment="Tabular" />
              </Grid>
              <ProgressBar x:Name="bar" Style="{StaticResource Bar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,5,0,0" />
              <TextBlock Text="{Binding ResetText}" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="bar" Property="Foreground" Value="{DynamicResource Orange}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Critical">
                <Setter TargetName="bar" Property="Foreground" Value="{DynamicResource Red}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- This week by surface (seven_day_breakdown) -->
      <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource Vis}}">
        <Rectangle Style="{StaticResource Divider}" />
        <TextBlock Text="This week by surface" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0" />
        <ItemsControl ItemsSource="{Binding Breakdown}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,6,0,0">
                <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Secondary}" Typography.NumeralAlignment="Tabular" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Rectangle Style="{StaticResource Divider}" />
      <CheckBox Style="{StaticResource Check}" Content="Launch at startup" Margin="0,12,0,0"
                IsChecked="{Binding LaunchAtLogin}" />
      <CheckBox Style="{StaticResource Check}" Content="Show % in tray icon" Margin="0,8,0,0"
                IsChecked="{Binding ShowPercentInTray}" />
      <TextBlock Text="{Binding LoginError}" FontSize="10" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Visibility="{Binding HasLoginError, Converter={StaticResource Vis}}" />

      <Rectangle Style="{StaticResource Divider}" />
      <DockPanel Margin="0,8,0,-4" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdatedText}" FontSize="10" Foreground="{DynamicResource Secondary}"
                   VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="Quit" Click="Quit_Click"
                AutomationProperties.Name="Quit" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="Open usage page"
                Click="Web_Click" AutomationProperties.Name="Open usage page" />
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Refresh" IsEnabled="{Binding CanRefresh}"
                Click="Refresh_Click" AutomationProperties.Name="Refresh">
          <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><RotateTransform x:Name="Spin" /></TextBlock.RenderTransform>
          </TextBlock>
        </Button>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
